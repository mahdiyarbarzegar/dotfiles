[core]
    autocrlf = input

[init]
    defaultBranch = main

[url "git@github.com:"]
    insteadOf = https://github.com/

[url "git@gitlab.com:"]
    insteadOf = https://gitlab.com/

[url "git@bitbucket.org:"]
    insteadOf = https://bitbucket.org/

[include]
    path = ~/.config/git/local.gitconfig
